aws_region      = "ap-south-1"
project_name    = "three-tier-capstone"
domain_name     = "app.example.com"
certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/REPLACE-ME"
container_tag   = "latest"
db_username     = "appuser"
# Do not put db_password here. Set TF_VAR_db_password in your shell/environment instead.
